

# Copiá este archivo como .env y completá los valores reales

# Base de datos
DB_USER=
DB_PASSWORD=
DB_NAME=teradb

# JWT
JWT_KEY=
JWT_ISSUER=TeraAPI
JWT_AUDIENCE=TeraAPIUsers

# URL del frontend (para links en emails)
FRONTEND_BASE_URL=http://localhost:5173

# SMTP
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER_NAME="TeraGestion Notificaciones"
SMTP_SENDER_EMAIL=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENABLE_SSL=true

# reCAPTCHA v3
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
